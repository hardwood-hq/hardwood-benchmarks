<svg xmlns="http://www.w3.org/2000/svg" width="$width" height="$height" viewBox="0 0 $width $height" font-family="-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif">
  <rect width="$width" height="$height" fill="#ffffff"/>

  <!-- Title -->
  <text x="40" y="30" font-size="20" font-weight="700" fill="#1a1a1a">$title</text>
  <text x="40" y="50" font-size="12.5" fill="#495057">$subtitle</text>
  <text x="40" y="67" font-size="11" fill="#868e96">$machine, warm cache</text>

  <!-- Legend: one entry per snapshot, oldest first -->
  $legend

  <!-- Gridlines, ticks, bars, whiskers, value labels, ratios (data-driven) -->
  $body

  <!-- Footnote and warnings -->
  $footer
</svg>
